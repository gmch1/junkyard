[Unit]
Description=Bemfa to Android BLE lamp bridge
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=bemfa-lamp-bridge
Image=localhost/bemfa-lamp-bridge:REPLACE_WITH_IMMUTABLE_TAG
Pull=never
Network=host
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
PidsLimit=64
Memory=64m
Environment=BEMFA_BRIDGE_BROKER_URL=ssl://bemfa.com:9503
Environment=BEMFA_BRIDGE_TOPIC=xidingdeng002xidingdeng002
Environment=BEMFA_BRIDGE_UID_FILE=/run/secrets/bemfa-uid
Environment=BEMFA_BRIDGE_LAMP_API_URL=http://192.168.31.129:8791
Environment=BEMFA_BRIDGE_LAMP_TOKEN_FILE=/run/secrets/lamp-api-token
Environment=BEMFA_BRIDGE_DRY_RUN=true
Environment=BEMFA_BRIDGE_HTTP_TIMEOUT=3s
Environment=BEMFA_BRIDGE_DEDUP_WINDOW=5s
Secret=bemfa-uid,type=mount,target=bemfa-uid,uid=65532,gid=65532,mode=0400
Secret=lamp-api-token,type=mount,target=lamp-api-token,uid=65532,gid=65532,mode=0400
PodmanArgs=--cpus=0.25

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=default.target
